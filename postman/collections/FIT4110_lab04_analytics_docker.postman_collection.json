              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "daily-summary"],
              "query": [{ "key": "date", "value": "2026-08-13" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response matches DailySummaryReport schema', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('date', '2026-08-13');",
                  "  pm.expect(json).to.have.property('total_access');",
                  "  pm.expect(json).to.have.property('total_alerts');",
                  "  pm.expect(json.total_access).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/analytics/metrics/temperature - get temperature metrics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/metrics/temperature?room_id=ROOM-101",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "metrics", "temperature"],
              "query": [{ "key": "room_id", "value": "ROOM-101" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is array of temperature metrics', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "  pm.expect(json.length).to.be.greaterThan(0);",
                  "  pm.expect(json[0]).to.have.property('room_id', 'ROOM-101');",
                  "  pm.expect(json[0]).to.have.property('avg_temperature');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/analytics/metrics/access-stats - get access stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/metrics/access-stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "metrics", "access-stats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is array of access stat metrics', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "  pm.expect(json.length).to.be.greaterThan(0);",
                  "  pm.expect(json[0]).to.have.property('time_bucket');",
                  "  pm.expect(json[0]).to.have.property('entry_count');",
