{
  "info": {
    "_postman_id": "fit4110-lab04-analytics-docker",
    "name": "FIT4110 Lab04 Analytics Docker Verification",
    "description": "Postman Collection kiểm thử đóng gói Docker và hợp đồng API cho Analytics Service (Lab 04).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const prefix = pm.environment.get('tracePrefix') || 'fit4110-lab04';",
          "pm.variables.set('traceId', prefix + '-' + Date.now());",
          "pm.request.headers.upsert({ key: 'X-Trace-Id', value: pm.variables.get('traceId') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00_Health",
      "item": [
        {
          "name": "GET /health - service is alive and healthy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has status ok', function () { const json = pm.response.json(); pm.expect(json.status).to.eql('ok'); });",
                  "pm.test('Response identifies analytics service', function () { const json = pm.response.json(); pm.expect(json.service).to.eql('analytics-service'); pm.expect(json).to.have.property('version'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "POST /api/v1/analytics/events/ingest - ingest telemetry event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/events/ingest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "events", "ingest"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"eventType\": \"telemetry.ingested\",\n  \"occurredAt\": \"2026-08-13T09:15:00Z\",\n  \"correlationId\": \"f1e2d3c4-b5a6-7890-abcd-ef1234567890\",\n  \"source\": \"iot-ingestion\",\n  \"data\": {\n    \"deviceId\": \"SENSOR-001\",\n    \"zoneId\": \"ROOM-101\",\n    \"metric\": \"temperature\",\n    \"value\": 29.5,\n    \"unit\": \"celsius\",\n    \"sampledAt\": \"2026-08-13T09:14:58Z\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created or 200 OK', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "pm.test('Response indicates processed event', function () { const json = pm.response.json(); pm.expect(json).to.have.property('eventId'); pm.expect(json.status).to.include('PROCESSED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/analytics/events/ingest - ingest access log event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/events/ingest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "events", "ingest"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"770e8400-e29b-41d4-a716-446655440002\",\n  \"eventType\": \"access.log.created\",\n  \"occurredAt\": \"2026-08-13T09:25:30Z\",\n  \"correlationId\": \"9f666062-a41d-63f6-c938-668877662222\",\n  \"source\": \"access-gate\",\n  \"data\": {\n    \"gate_id\": \"GATE-01\",\n    \"direction\": \"IN\",\n    \"card_id_hash\": \"sha256:abc123456\",\n    \"user_type\": \"student\",\n    \"recorded_at\": \"2026-08-13T09:25:30Z\"\n  }\n}"
            }
