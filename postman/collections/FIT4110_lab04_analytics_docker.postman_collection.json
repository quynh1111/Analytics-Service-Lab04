      "item": [
        {
          "name": "GET /api/v1/analytics/daily-summary - valid token is accepted",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/daily-summary?date=2026-08-13",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "daily-summary"],
              "query": [{ "key": "date", "value": "2026-08-13" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valid token request returns success 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/analytics/daily-summary - missing token is rejected on real service",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/daily-summary?date=2026-08-13",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "daily-summary"],
              "query": [{ "key": "date", "value": "2026-08-13" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const env = pm.environment.get('env') || 'mock';",
                  "if (env === 'mock') {",
                  "  pm.test('Skipped on mock', function () { pm.expect(true).to.eql(true); });",
                  "} else {",
                  "  pm.test('Missing token returns 401 or 403', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "  });",
                  "  pm.test('Response follows ProblemDetails', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('title');",
                  "    pm.expect(json).to.have.property('status');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/analytics/daily-summary - invalid token is rejected on real service",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer invalid-token-12345" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/daily-summary?date=2026-08-13",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "daily-summary"],
              "query": [{ "key": "date", "value": "2026-08-13" }]
