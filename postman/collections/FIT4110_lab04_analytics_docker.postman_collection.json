        },
        {
          "name": "GET /api/v1/analytics/metrics/events - get anomaly events",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/metrics/events?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "metrics", "events"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains anomaly events', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "  if (json.length > 0) {",
                  "    pm.expect(json[0]).to.have.property('event_id');",
                  "    pm.expect(json[0]).to.have.property('event_type');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
